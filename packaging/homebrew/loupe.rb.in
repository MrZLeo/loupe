class Loupe < Formula
  desc "Terminal viewer for coding-agent session logs"
  homepage "https://github.com/mrzleo/loupe"
  url "https://github.com/mrzleo/loupe/releases/download/@TAG@/loupe-@TAG@-macos-universal.tar.gz"
  sha256 "@MACOS_SHA256@"
  license "BSD-3-Clause"

  depends_on macos: :ventura

  resource "license" do
    url "https://raw.githubusercontent.com/mrzleo/loupe/@TAG@/LICENSE"
    sha256 "@LICENSE_SHA256@"
  end

  def install
    bin.install "loupe"
    pkgshare.install "THIRD_PARTY_LICENSES.md"
    resource("license").stage { pkgshare.install "LICENSE" }
  end

  test do
    assert_match "loupe #{version}", shell_output("#{bin}/loupe --version")
  end
end
